# Tested sample configuration. yamlgraph resolves PROVIDER, then <PROVIDER>_MODEL;
# omit either and the framework default applies (recorded as "framework-default").
PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
